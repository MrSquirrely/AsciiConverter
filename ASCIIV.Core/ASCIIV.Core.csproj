<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Fonts that ASCII frames can be drawn with; copied next to every app that uses Core.
         Shrek.ttf is not in the repository (see the README), so it is only included when present -->
    <Content Include="Fonts\Shrek.ttf" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Fonts\Shrek.ttf')" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Controls\ColorPickerWindow.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Controls\CustomMessageBox.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
  </ItemGroup>

</Project>
