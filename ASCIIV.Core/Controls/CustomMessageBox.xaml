<Window x:Class="ASCIIV.Core.Controls.CustomMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Message" Height="220" Width="440"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        AllowsTransparency="True" Background="Transparent"
        FontFamily="{StaticResource PixelatedEleganceFont}"
        Topmost="True">

    <Border x:Name="MainBorder" CornerRadius="10" BorderThickness="2"
            BorderBrush="{StaticResource MainGradientBrush}"
            Background="{StaticResource WindowBackgroundBrush}"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="5" Opacity="0.6"/>
        </Border.Effect>

        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleText" Text="Notification"
                       Style="{StaticResource TitleBarTextStyle}"
                       FontSize="14" Margin="10,0,0,0"/>

            <Button Grid.Row="0" x:Name="CloseButton" HorizontalAlignment="Right"
                    Style="{StaticResource TitleBarCloseButtonStyle}"
                    Width="30" Height="26" FontSize="14" Content="X"
                    ToolTip="Close this message"
                    Click="CloseButton_Click"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="15,10,15,10">
                <TextBlock x:Name="MessageText"
                           Text="Your message goes here..."
                           Style="{StaticResource ModernTextBlock}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"/>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">

                <Button x:Name="OkButton" Content="OK"
                        Style="{StaticResource GradientRoundedButtonStyle}"
                        Width="100" Height="35" Margin="5"
                        IsDefault="True"
                        ToolTip="Confirm and close (Enter)"
                        Click="OkButton_Click"/>

                <Button x:Name="CancelButton" Content="Cancel"
                        Style="{StaticResource GradientRoundedButtonStyle}"
                        Width="100" Height="35" Margin="5"
                        IsCancel="True"
                        ToolTip="Close without confirming (Esc)"
                        Click="CloseButton_Click"
                        Visibility="Collapsed"/>

            </StackPanel>
        </Grid>
    </Border>
</Window>