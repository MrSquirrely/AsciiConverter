<Window x:Class="ASCIIV.Converter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        ResizeMode="CanResize" 
        MinHeight="650" MinWidth="750"
        Height="760" Width="840"
        Title="Video to ASCII Converter"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Loaded="MainWindow_Loaded"
        FontFamily="{StaticResource PixelatedEleganceFont}">

    <Border CornerRadius="10" BorderThickness="2" BorderBrush="{StaticResource MainGradientBrush}">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#444" Offset="0.0"/>
                <GradientStop Color="#222" Offset="1.0"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" 
                    Background="#202020" 
                    CornerRadius="8,8,0,0" 
                    MouseDown="TitleBar_MouseDown">

                <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Video to ASCIIV Converter" 
                               Foreground="White" 
                               VerticalAlignment="Center" 
                               Margin="15,0,0,0"
                               FontSize="16"
                               Opacity="1.0"
                               FontWeight="SemiBold"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,5,0">
                        <Button Content="_" Click="MinimizeButton_Click"
                                Style="{StaticResource TitleBarButtonStyle}" 
                                Width="40" Height="30" Margin="0,0,0,0"
                                Padding="0,-10,0,0"/>

                        <Button Content="X" Click="CloseButton_Click"
                                Style="{StaticResource TitleBarCloseButtonStyle}" 
                                Width="40" Height="30"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="25,10,25,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- 0: Header 1 -->
                    <RowDefinition Height="Auto"/>
                    <!-- 1: Load Video Button -->
                    <RowDefinition Height="Auto"/>
                    <!-- 2: Project Name -->
                    <RowDefinition Height="15"/>
                    <!-- 3: Spacer -->
                    <RowDefinition Height="Auto"/>
                    <!-- 4: Header 2 -->
                    <RowDefinition Height="Auto"/>
                    <!-- 5: Options Row 1 (Audio & Output) -->
                    <RowDefinition Height="Auto"/>
                    <!-- 6: Options Row 2 (Style & Contrast) -->
                    <RowDefinition Height="Auto"/>
                    <!-- 7: Convert / Cancel Buttons -->
                    <RowDefinition Height="Auto"/>
                    <!-- 8: Status Text -->
                    <RowDefinition Height="Auto"/>
                    <!-- 9: Progress Bar -->
                    <RowDefinition Height="*"/>
                    <!-- 10: Live ASCII Preview Container -->
                    <RowDefinition Height="Auto"/>
                    <!-- 11: Play Last Output Button -->
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="1. Select a Video File" 
                           Style="{StaticResource ModernTextBlock}" Margin="0,0,0,10"/>

                <Button Grid.Row="1" x:Name="LoadButton" 
                        IsEnabled="False"
                        Style="{StaticResource GradientRoundedButtonStyle}" 
                        Content="Load Video" Click="LoadButton_Click" 
                        Height="45" Margin="0,0,0,10"/>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,0">
                    <Label Content="Project Name:" FontWeight="SemiBold" 
                           VerticalAlignment="Center" 
                           Foreground="White" FontSize="14"/>
                    <TextBox x:Name="ProjectNameText" Width="520" 
                             Style="{StaticResource ModernTextBox}"/>
                </StackPanel>

                <TextBlock Grid.Row="4" Text="2. Configure Output" 
                           Style="{StaticResource ModernTextBlock}" Margin="0,10,0,10"/>

                <!-- Row 5: Crush Audio + sliders & MP4 & Color -->
                <WrapPanel Grid.Row="5" Margin="0,0,0,10" Orientation="Horizontal">
                    <CheckBox Name="BitCrushCheck" Content="Crush Audio" IsChecked="True" 
                              Style="{StaticResource ModernCheckBox}" Margin="0,0,15,0"/>

                    <!-- UX FEATURE: BitCrush parameter sliders -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0"
                                IsEnabled="{Binding ElementName=BitCrushCheck, Path=IsChecked}">
                        <Label Content="Bits:" Foreground="White" FontSize="12" VerticalAlignment="Center" Padding="0,0,4,0"/>
                        <Slider x:Name="BitDepthSlider" Style="{StaticResource ModernSlider}"
                                Minimum="2" Maximum="16" Value="9" Width="70"
                                VerticalAlignment="Center" AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="0"/>
                        <Label Content="Downsample:" Foreground="White" FontSize="12" VerticalAlignment="Center" Padding="8,0,4,0"/>
                        <Slider x:Name="DownsampleSlider" Style="{StaticResource ModernSlider}"
                                Minimum="2" Maximum="30" Value="10" Width="70"
                                VerticalAlignment="Center" AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="0"/>
                    </StackPanel>

                    <CheckBox Name="ToMp4Check" Content="Create MP4" IsChecked="False" 
                              Style="{StaticResource ModernCheckBox}" Margin="0,0,20,0" 
                              Checked="ToMp4Check_Checked"/>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Label Content="Color:" VerticalAlignment="Center" 
                               Padding="0,0,8,0" Foreground="White" 
                               FontSize="14" FontWeight="SemiBold"/>
                        <ComboBox x:Name="ColorComboBox" Width="110" SelectedIndex="0" 
                                  VerticalAlignment="Center" 
                                  Style="{StaticResource ModernComboBox}">
                            <ComboBoxItem Content="White"/>
                            <ComboBoxItem Content="Lime"/>
                            <ComboBoxItem Content="Red"/>
                            <ComboBoxItem Content="Cyan"/>
                            <ComboBoxItem Content="Yellow"/>
                        </ComboBox>
                        <Button x:Name="CustomColorButton" 
                                Click="CustomColorButton_OnClick" Width="36" Height="36"
                                ToolTip="Pick Custom Color"
                                Margin="8,0"
                                Style="{StaticResource GradientRoundedButtonStyle}">
                            <Path x:Name="PlayButtonIcon"
                                  Data="{StaticResource ColorPickerIcon}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Stretch="Uniform" Height="14" Width="14"/>
                        </Button>
                    </StackPanel>
                </WrapPanel>

                <!-- Row 6: Text Style & Video Width & Contrast & Invert -->
                <WrapPanel Grid.Row="6" Orientation="Horizontal" Margin="0,0,0,15">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Label Content="Text Style:" VerticalAlignment="Center" 
                               Padding="0,0,8,0" Foreground="White" 
                               FontSize="14" FontWeight="SemiBold"/>
                        <ComboBox x:Name="TextStyleComboBox" Width="120" SelectedIndex="0" IsEditable="True"
                                  VerticalAlignment="Center" Style="{StaticResource ModernComboBox}">
                            <ComboBoxItem Content="Standard"/>
                            <ComboBoxItem Content="Binary"/>
                            <ComboBoxItem Content="High Detail"/>
                            <ComboBoxItem Content="Blocks"/>
                            <ComboBoxItem Content="Glitch"/>
                            <ComboBoxItem Content="Optimized"/>
                        </ComboBox>

                        <Label Content="Width:" VerticalAlignment="Center" 
                               Padding="15,0,8,0" Foreground="White" 
                               FontSize="14" FontWeight="SemiBold"/>
                        <Slider x:Name="VideoWidthSlider" Style="{StaticResource ModernSlider}" 
                                Minimum="50" Maximum="400" Value="150" 
                                Width="120" VerticalAlignment="Center"
                                AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="0"/>

                        <!-- UX FEATURE: Contrast adjustment slider -->
                        <Label Content="Contrast:" VerticalAlignment="Center" 
                               Padding="15,0,8,0" Foreground="White" 
                               FontSize="14" FontWeight="SemiBold"/>
                        <Slider x:Name="ContrastSlider" Style="{StaticResource ModernSlider}" 
                                Minimum="0.5" Maximum="2.5" Value="1.0" 
                                Width="90" VerticalAlignment="Center"
                                AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="1"/>

                        <!-- UX FEATURE: Invert color mapping -->
                        <CheckBox x:Name="InvertCheck" Content="Invert" IsChecked="False"
                                  Style="{StaticResource ModernCheckBox}" Margin="15,0,0,0"/>
                    </StackPanel>
                </WrapPanel>

                <!-- Row 7: Convert & Cancel Buttons -->
                <Grid Grid.Row="7" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="ConvertButton" 
                            Style="{StaticResource GradientRoundedButtonStyle}" 
                            Content="Convert &amp; Save" Click="ConvertButton_Click" 
                            Height="45" IsEnabled="False" Margin="0,0,10,0"/>
                    <!-- UX FEATURE: Cancellation button -->
                    <Button Grid.Column="1" x:Name="CancelButton" 
                            Style="{StaticResource GradientRoundedButtonStyle}" 
                            Content="Cancel" Click="CancelButton_Click" 
                            Height="45" Width="100" IsEnabled="False" Visibility="Collapsed"/>
                </Grid>

                <TextBlock Grid.Row="8" x:Name="StatusText" Text="Ready" 
                           Style="{StaticResource ModernTextBlock}"
                           VerticalAlignment="Center" HorizontalAlignment="Center" 
                           Margin="0,0,0,8"/>

                <ProgressBar Grid.Row="9" x:Name="ConvertProgressBar"
                             Style="{StaticResource RainbowProgressStyle}" 
                             Height="16" Minimum="0" Maximum="100" Margin="0,0,0,10"/>

                <!-- Row 10: Live ASCII Preview Container -->
                <Border Grid.Row="10" x:Name="PreviewBorder" 
                        Background="#101010" CornerRadius="6" BorderBrush="#333333" BorderThickness="1"
                        MinHeight="80" MaxHeight="140" Margin="0,0,0,10">
                    <Viewbox Stretch="Uniform" Margin="4">
                        <TextBlock x:Name="PreviewText" Text="Live ASCII Preview"
                                   FontFamily="Consolas, Courier New, Monospace"
                                   Foreground="White" FontWeight="Bold"
                                   TextAlignment="Left"/>
                    </Viewbox>
                </Border>

                <!-- Row 11: Play Button -->
                <Button Grid.Row="11" x:Name="PlayButton" 
                        Style="{StaticResource GradientRoundedButtonStyle}" 
                        Content="Play Last Output" Click="PlayButton_Click" 
                        Height="45"/>
            </Grid>
        </Grid>
    </Border>
</Window>